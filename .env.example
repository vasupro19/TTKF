# ============================================================================
#  TTK TRAVEL CRM — WEB CLIENT CONFIGURATION
# ============================================================================
#
#      cp .env.example .env
#
#  IMPORTANT: Vite inlines every VITE_* variable into the bundle AT BUILD TIME.
#  They are therefore:
#    - baked in, so changing one needs a rebuild, not a restart
#    - PUBLIC, visible to anyone who opens devtools
#
#  Never put a secret here. There is no API key, no token, nothing private —
#  the browser authenticates with httpOnly cookies the API sets, which
#  JavaScript cannot read.
# ============================================================================

# Base URL of the API, including the /v1 prefix and no trailing slash.
# This origin must also appear in the API's CORS_URLS, or every request is
# blocked by the browser.
VITE_APP_BASE_URL=http://localhost:1310/v1

# Cookie name prefix. MUST match APP_NAME in the API's .env — the client reads
# the `<APP_NAME>-csrf` cookie to echo it back on writes, and a mismatch means
# every state-changing request is rejected with "Missing CSRF token".
VITE_APP_NAME=TTK

# local | development | production
VITE_APP_ENV=local
